{
  "name": "bookmark-proofbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "npm run build:extension && vite build --config vite.site.config.ts && node scripts/package-extension.mjs",
    "build:extension": "wxt zip",
    "build": "npm run build:site",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "wxt": "^0.20.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.0.303",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
